@using RestERP.Core.Domain.Entities
@model IEnumerable<ApplicationUser>  
@{  
    ViewData["Title"] = "Personel ve Müşteri Yönetimi";  
}  

<link rel="stylesheet" href="~/css/admin/user.css" asp-append-version="true" />

<div class="person-container" data-delete-url="@Url.Action("Delete", "User")">  
    <div class="person-header">  
        <div class="container">  
            <div class="row align-items-center">  
                <div class="col-lg-8">  
                    <h1 class="person-title">Personel ve Müşteri Yönetimi</h1>  
                    <p class="person-subtitle">Personel ve Müşteri bilgilerini yönetin</p>  
                </div>  
                <div class="col-lg-4">  
                    <a href="@Url.Action("Create", "User")" class="btn btn-primary add-person-btn">  
                        <i class="bi bi-plus-circle"></i> Yeni Ekle  
                    </a>  
                </div>  
            </div>  
        </div>  
    </div>  

    <div class="container person-content">  
        <div class="col-12">  
            <div class="card">  
                <div class="card-body">  
                    <h5 class="card-title">Personel</h5>  
                    <div class="table-responsive">  
                        <table class="table table-hover">  
                            <thead>  
                                <tr>  
                                    <th>Ad</th>  
                                    <th>Soyad</th>  
                                    <th>Kullanıcı Adı</th>
                                    <th>Pozisyon</th>  
                                    <th>Telefon</th>  
                                    <th>E-posta</th>  
                                    <th>Durum</th>
                                    <th>Kayıt Tarihi</th>
                                    <th>İşlemler</th>  
                                </tr>  
                            </thead>  
                            <tbody>  
                                @foreach (var person in Model.Where(u => u.RoleType == RestERP.Domain.Enums.Role.Employee || u.RoleType == RestERP.Domain.Enums.Role.Admin))  
                                {  
                                    <tr>  
                                        <td>@person.FirstName</td>  
                                        <td>@person.LastName</td>
                                        <td>@person.UserName</td>
                                        <td>@person.RoleType</td>  
                                        <td>@person.PhoneNumber</td>  
                                        <td>@person.Email</td>  
                                        <td>  
                                            @if (person.IsActive)  
                                            {  
                                                <span class="badge bg-success">Aktif</span>  
                                            }  
                                            else  
                                            {  
                                                <span class="badge bg-danger">Pasif</span>  
                                            }  
                                        </td>
                                        <td>-</td>
                                        <td>  
                                            <a href="@Url.Action("Edit", "User", new { id = person.Id })" class="btn btn-sm btn-info">  
                                                <i class="bi bi-pencil"></i>  
                                            </a>  
                                            <a href="javascript:void(0)" onclick="deletePerson('@person.Id')" class="btn btn-sm btn-danger">  
                                                <i class="bi bi-trash"></i>  
                                            </a>  
                                        </td>  
                                    </tr>  
                                }  
                            </tbody>  
                        </table>  
                    </div>  
                </div>  
            </div>  
        </div>  

        <!-- Kullanıcı Kayıtları Bölümü -->
        <div class="col-12 mt-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Müşteriler</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Ad</th>
                                    <th>Soyad</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>Pozisyon</th>
                                    <th>Telefon</th>
                                    <th>E-posta</th>
                                    <th>Durum</th>
                                    <th>Kayıt Tarihi</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var person in Model.Where(u => u.RoleType == RestERP.Domain.Enums.Role.Customer))
                                {
                                    <tr>
                                        <td>@person.FirstName</td>
                                        <td>@person.LastName</td>
                                        <td>@person.UserName</td>
                                        <td>@person.RoleType</td>
                                        <td>@person.PhoneNumber</td>
                                        <td>@person.Email</td>
                                        <td>
                                            @if (person.IsActive)
                                            {
                                                <span class="badge bg-success">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Pasif</span>
                                            }
                                        </td>
                                        <td>-</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="@Url.Action("Edit", "User", new { id = person.Id })" class="btn btn-sm btn-info" title="Düzenle">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="javascript:void(0)" onclick="deletePerson('@person.Id')" class="btn btn-sm btn-danger" title="Sil">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css">

@section Scripts {
    <script src="~/js/admin/user.js" asp-append-version="true"></script>
}
