@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<link rel="stylesheet" href="~/css/access-denied.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 text-danger">Erişim Reddedildi</h1>
            <p class="lead">Bu sayfaya erişim yetkiniz bulunmamaktadır.</p>
            <p>Lütfen giriş yapın veya yetkili bir kullanıcı ile iletişime geçin.</p>
            <a href="@Url.Action("Index", "Login")" class="btn btn-primary">Giriş Yap</a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Ana Sayfaya Dön</a>
        </div>
    </div>
</div>
